+/// Adds a child node (e.g. an EFFECTS_PARAMETERS under PADEFFECTS) at `parent_str`,
+/// then sets `props` ("name=type:value") on it in the same connection.
+pub fn add_child(
+    ctx: &Context,
+    parent_str: &str,
+    insert_at: usize,
+    node_name: &str,
+    props: &[String],
+) -> Result<(), Box<dyn std::error::Error>> {
+    let parent: Vec<usize> = if parent_str.trim().is_empty() {
+        Vec::new()
+    } else {
+        parent_str
+            .split(',')
+            .map(|s| s.trim().parse())
+            .collect::<Result<_, _>>()?
+    };
+    let mut parsed = Vec::new();
+    for p in props {
+        let (name, val) = p
+            .split_once('=')
+            .ok_or_else(|| format!("invalid property '{p}' (use name=type:value)"))?;
+        parsed.push((name.to_string(), parse_value(val)?));
+    }
+
+    let conn = super::open_connection(ctx)?;
+    conn.wait_for_state()?;
+
+    println!("adding {node_name} at [{parent_str}] position {insert_at}");
+    conn.send_packet(Box::new(rcp2_protocol::packet::child_added::ChildAddedPacket {
+        path: parent.clone(),
+        insert_index: insert_at,
+        node_name: node_name.into(),
+    }))?;
+    std::thread::sleep(std::time::Duration::from_millis(150));
+
+    let mut indices = parent;
+    indices.push(insert_at);
+    for (name, value) in parsed {
+        conn.send_property_update(indices.clone(), name.into(), value)?;
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    conn.flush()?;
+    println!("done");
+    Ok(())
+}
+
