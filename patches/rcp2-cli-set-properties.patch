+/// Sets several properties ("name=type:value") on one node in a single connection.
+pub fn set_properties(
+    ctx: &Context,
+    indices_str: &str,
+    props: &[String],
+) -> Result<(), Box<dyn std::error::Error>> {
+    let indices: Vec<usize> = indices_str
+        .split(',')
+        .map(|s| s.trim().parse())
+        .collect::<Result<_, _>>()?;
+    let mut parsed = Vec::new();
+    for p in props {
+        let (name, val) = p
+            .split_once('=')
+            .ok_or_else(|| format!("invalid property '{p}' (use name=type:value)"))?;
+        parsed.push((name.to_string(), parse_value(val)?));
+    }
+
+    let conn = super::open_connection(ctx)?;
+    conn.wait_for_state()?;
+
+    for (name, value) in parsed {
+        println!("setting [{indices_str}] {name} = {value:?}");
+        conn.send_property_update(indices.clone(), name.into(), value)?;
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    conn.flush()?;
+    println!("done");
+    Ok(())
+}
